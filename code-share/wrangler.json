{
  "name": "cloud-mail-code-share",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {"binding": "MAIL_DB", "database_name": "mail-db", "database_id": "00000000-0000-0000-0000-000000000001"},
    {"binding": "SHARE_DB", "database_name": "mail-code-share", "database_id": "00000000-0000-0000-0000-000000000002"}
  ],
  "ratelimits": [{"name": "AUTH_LIMITER", "namespace_id": "891702", "simple": {"limit": 10, "period": 60}}],
  "vars": {"ALLOWED_DOMAINS": "example.com"},
  "observability": {"enabled": false}
}
